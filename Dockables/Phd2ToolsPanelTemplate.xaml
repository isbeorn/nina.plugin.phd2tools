<ResourceDictionary
    x:Class="NINA.Plugin.Phd2Tools.Dockables.Phd2ToolsPanelTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:NINA.Core.Utility.Converters;assembly=NINA.Core"
    xmlns:local="clr-namespace:NINA.Plugin.Phd2Tools.Dockables"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Contrib.Wpf">

    <core:InverseNullToVisibilityCollapsedConverter x:Key="InverseNullToVisibilityCollapsedConverter" />

    <GeometryGroup x:Key="PhdTools_StarSVG">
        <PathGeometry Figures="M 12.1147,57.26C 11.8907,57.26 11.672,57.192 11.4853,57.0573C 11.1573,56.8173 10.9947,56.416 11.0627,56.016L 14.36,36.796L 0.396,23.1867C 0.104,22.9013 4.07298e-007,22.4787 0.125334,22.0933C 0.250667,21.708 0.584,21.4267 0.990667,21.3693L 20.2813,18.5627L 28.912,1.07733C 29.0947,0.713333 29.464,0.483997 29.8707,0.483997C 30.276,0.483997 30.6467,0.713333 30.824,1.07733L 39.4533,18.5627L 58.7507,21.3693C 59.152,21.4267 59.4853,21.708 59.6147,22.0933C 59.74,22.4787 59.636,22.9053 59.344,23.1867L 45.38,36.796L 48.6773,56.016C 48.7453,56.416 48.5787,56.8227 48.2507,57.0627C 47.9227,57.3013 47.4907,57.3333 47.1307,57.14L 29.8707,48.068L 12.6093,57.14C 12.4533,57.224 12.2813,57.26 12.1147,57.26 Z M 3.43333,23.1667L 16.2507,35.6613C 16.5,35.9053 16.6147,36.26 16.5573,36.604L 13.532,54.244L 29.376,45.916C 29.6827,45.7547 30.052,45.7547 30.3653,45.916L 46.2093,54.244L 43.1827,36.604C 43.1253,36.26 43.24,35.9053 43.4907,35.6613L 56.308,23.1667L 38.5947,20.5933C 38.2453,20.5413 37.948,20.3227 37.792,20.0107L 29.8707,3.96267L 21.948,20.0107C 21.792,20.328 21.4907,20.5467 21.1467,20.5933" />
    </GeometryGroup>

    <DataTemplate DataType="{x:Type local:Phd2InfoPanel}">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="LabelPanel"
                Margin="0,0,5,5"
                Grid.IsSharedSizeScope="True"
                Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="State:" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Text="{Binding AppState}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Exposure Time:" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock Text="{Binding ExposureTime}" />
                        <TextBlock Text=" s" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Peak:" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock Text="{Binding Peak}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mid row FWHM:" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock Text="{Binding FWHM, StringFormat=\{0:0.00\}}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Guide Star HFD:" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock Text="{Binding HFD, StringFormat=\{0:0.00\}}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Guide Star SNR:" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock Text="{Binding SNR, StringFormat=\{0:0.00\}}" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Guide Star Mass:" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock Text="{Binding StarMass, StringFormat=\{0:0.00\}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Viewbox
                Grid.Column="1"
                Height="{Binding ActualHeight, ElementName=LabelPanel}"
                HorizontalAlignment="Left"
                Stretch="Uniform">
                <Canvas Width="{Binding StarImage.Width}" Height="{Binding StarImage.Height}">
                    <Canvas.Background>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Image Source="{Binding StarImage}" Stretch="Uniform" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Canvas.Background>
                    <!--<Line
                        Margin="7.5,0,0,0"
                        SnapsToDevicePixels="False"
                        Stretch="Uniform"
                        Stroke="Green"
                        StrokeDashArray="1 1 1"
                        StrokeThickness="0.125"
                        X1="0"
                        X2="0"
                        Y1="0"
                        Y2="15" />
                    <Line
                        Margin="0,7.5,0,0"
                        SnapsToDevicePixels="False"
                        Stretch="Uniform"
                        Stroke="Green"
                        StrokeDashArray="1 1 1"
                        StrokeThickness="0.125"
                        X1="0"
                        X2="15"
                        Y1="7.5"
                        Y2="7.5" />-->
                    <Rectangle
                        Canvas.Left="{Binding StarCenter.X}"
                        Canvas.Top="{Binding StarCenter.Y}"
                        Width="0.25"
                        Height="0.25"
                        Fill="Red"
                        SnapsToDevicePixels="False" />
                </Canvas>
            </Viewbox>
            <Path
                Grid.Column="1"
                Width="100"
                Height="100"
                Margin="5"
                Data="{StaticResource StarSVG}"
                Fill="{StaticResource ButtonForegroundDisabledBrush}"
                Stretch="Uniform"
                Visibility="{Binding StarImage, Converter={StaticResource InverseNullToVisibilityCollapsedConverter}}" />

            <oxy:Plot
                Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                DataContext="{Binding}"
                PlotAreaBackground="Transparent"
                PlotAreaBorderColor="{Binding Path=Color, Source={StaticResource BorderBrush}}">
                <oxy:Plot.Axes>
                    <oxy:LinearAxis
                        Key="Midrow"
                        AxislineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}"
                        IntervalLength="50"
                        IsAxisVisible="False"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=100}"
                        MajorGridlineStyle="LongDash"
                        MinorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=50}"
                        MinorGridlineStyle="Dash"
                        Position="Left"
                        TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}" />

                    <oxy:LinearAxis
                        IsAxisVisible="False"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        Position="Bottom"
                        TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />
                </oxy:Plot.Axes>
                <oxy:Plot.Series>
                    <oxy:LineSeries
                        Title="Midrow"
                        DataFieldX="X"
                        DataFieldY="Y"
                        ItemsSource="{Binding MidrowPoints}"
                        YAxisKey="Midrow" />
                </oxy:Plot.Series>
            </oxy:Plot>
        </Grid>
    </DataTemplate>
</ResourceDictionary>