<ResourceDictionary
    x:Class="NINA.Plugin.Phd2Tools.Dockables.Phd2ToolsPanelTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.Phd2Tools.Dockables">

    <DataTemplate DataType="{x:Type local:Phd2InfoPanel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Image Source="{Binding StarImage}" />

            <StackPanel
                Grid.Row="1"
                Grid.IsSharedSizeScope="True"
                Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="State:" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Text="{Binding AppState}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Column1" />
                        <ColumnDefinition SharedSizeGroup="Column2" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Exposure Time:" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Orientation="Horizontal">
                        <TextBlock Text="{Binding ExposureTime}" />
                        <TextBlock Text=" s" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>